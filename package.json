{
  "name": "ruffle3d",
  "version": "0.1.0",
  "description": "Ruffle3D - a browser-based parametric 3D CAD tool (OpenCascade kernel via replicad, Three.js viewport)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bossman556/ruffle3d.git"
  },
  "homepage": "https://www.ruffle3d.site/",
  "bugs": {
    "url": "https://github.com/Bossman556/ruffle3d/issues"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/sketch.test.mjs && node tests/kernel.test.mjs && node tests/features2.test.mjs && node tests/demo.test.mjs && node tests/templates.test.mjs && node tests/surfaces.test.mjs && node tests/features3.test.mjs && node tests/dxf.test.mjs && node tests/sheetmetal.test.mjs && node tests/fea.test.mjs && node tests/text.test.mjs && node tests/drawing.test.mjs && node tests/fea2.test.mjs && node tests/import.test.mjs && node tests/cam.test.mjs && node tests/thermal.test.mjs && node tests/thickness.test.mjs && node tests/compare.test.mjs && node tests/topo.test.mjs && node tests/assembly.test.mjs && node tests/project.test.mjs && node tests/splineops.test.mjs && node tests/pathpattern.test.mjs && node tests/configcsv.test.mjs && node tests/history.test.mjs && node tests/standards.test.mjs && node tests/scripting.test.mjs && node tests/ellipse.test.mjs && node tests/rib.test.mjs && node tests/wrap.test.mjs && node tests/edges.test.mjs && node tests/pipe.test.mjs && node tests/cam.mate.test.mjs",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "site": "node scripts/serve.mjs website 5174",
    "site:build": "node scripts/build-site.mjs",
    "screens": "node scripts/capture-screens.mjs",
    "desktop": "vite build && electron .",
    "desktop:build": "node scripts/desktop.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/hashes": "^1.8.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "lucide": "^1.55.0",
    "qrcode": "^1.5.4",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "main": "electron/main.cjs",
  "productName": "Ruffle3D",
  "author": "Ruffle3D",
  "build": {
    "appId": "com.ruffle3d.app",
    "productName": "Ruffle3D",
    "copyright": "Copyright \u00a9 2026 Ruffle3D contributors. GPL-3.0-or-later",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Ruffle3D-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ruffle3D",
      "uninstallDisplayName": "Ruffle3D",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "Ruffle3D-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "Ruffle3D-${version}-linux.${ext}",
      "maintainer": "Ruffle3D"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "fileAssociations": [
      {
        "ext": "ruffle3d",
        "name": "Ruffle3D project",
        "description": "Ruffle3D project",
        "role": "Editor",
        "mimeType": "application/x-ruffle3d"
      }
    ]
  }
}
